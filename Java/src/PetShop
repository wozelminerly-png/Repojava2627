package petshopWeikang;

public class ClienteWeikang {
	private String nombre;
	private String direccion;
	private PerroHu perro ;
	public ClienteWeikang(String nombre, String direccion) {
		super();
		this.nombre = nombre;
		this.direccion = direccion;
	}
	@Override
	public String toString() {
		return "ClienteWeikang [nombre=" + nombre + ", direccion=" + direccion + ", perro=" + perro + "]";
	}
	public void comprarPerro(PerroHu perro) {
		this.perro = perro;
	}

}
