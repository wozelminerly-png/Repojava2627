				Zamora = porteros[i];
		}
		 System.out.println("El mejor portero es: " +
	                Zamora.getNombre() + " con " +
	               Zamora.getGolesRecibidos() + " goles recibidos, de equipo: "+Zamora.getEquipo());
	}
